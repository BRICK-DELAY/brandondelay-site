            },
            {
              "qty": "1 tbsp",
              "item": "vegetable oil (at home)"
            },
            {
              "qty": "",
              "item": "basmati rice (at home)"
            }
          ],
          "steps": [
            "Start the basmati rice.",
            "Sear the thighs in hot oil, 5-6 minutes per side, until browned and cooked through; set aside.",
            "In the same pan, soften the garlic for 30 seconds, then add the honey, soy sauce and a splash of water.",
            "Simmer 2-3 minutes until syrupy, return the thighs and turn to coat in the glaze.",
            "Microwave or saute the green beans with a little oil and salt until crisp-tender, about 5 minutes.",
            "Serve the thighs and beans over rice, spooning extra glaze on top."
          ],
          "notes": "The carry-over from last week, swapped out to make room for the green chile."
