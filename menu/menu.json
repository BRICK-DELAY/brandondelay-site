          "id": "honey-garlic-chicken-thighs",
          "name": "Honey garlic chicken thighs",
          "servings": 3,
          "time_min": 30,
          "active_min": 20,
          "ingredients": [
            {
              "qty": "~2 lb",
              "item": "boneless skinless chicken thighs"
            },
            {
              "qty": "1 lb",
              "item": "green beans",
